# 64-character hex string (32 bytes). Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-char-random-hex

# Public URL of this app (no trailing slash). Must match OAuth redirect configuration.
APP_BASE_URL=http://localhost:3000

# Steam OpenID realm — typically the same as APP_BASE_URL
STEAM_REALM=http://localhost:3000

# Optional. Improves wishlist API reliability when set.
STEAM_WEB_API_KEY=

# Google OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
